# ==================== NetGuard 配置 ====================
# 复制此文件为 .env 并填入实际值

# 安全（必填！不填启动会报错）
SECRET_KEY=your-secret-key-here-at-least-32-characters-long

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./netguard.db

# Redis（可选，用于多 worker 共享状态）
# REDIS_URL=redis://localhost:6379/0

# CORS 白名单（JSON 数组格式）
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 外部威胁情报 API（可选）
# VIRUSTOTAL_API_KEY=your-virustotal-api-key
# ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# 调试
DEBUG=false

# 限流（请求/分钟）
FREE_TIER_RATE=10
PRO_TIER_RATE=100

# 功能阈值
FREE_SCAN_LIMIT=5
PRO_SCAN_LIMIT=200
FREE_THREAT_LIMIT=10
PRO_THREAT_LIMIT=1000
FREE_ANALYSIS_LIMIT=3
PRO_ANALYSIS_LIMIT=50
FREE_PROTECTION_LIMIT=5
PRO_PROTECTION_LIMIT=50
