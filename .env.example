# ============================================
# Butler 环境配置（最小可用版）
# 首次启动时系统会自动从本文件生成 .env（也可手动复制）
# 您只需要：选一个服务商 + 填一个密钥，即可跑通核心 AI 流与本地 RAG。
#
# 完整可选项（8 家 AI 服务商 / 语音引擎 / MQTT 等）：
#   → docs/start/env-reference.md
# ============================================

# AI 服务提供商 (deepseek|openai|zhipu|anthropic|gemini|dashscope|qianfan|custom)
AI_PROVIDER=deepseek

# API 密钥：只需填写上面所选服务商对应的一个
DEEPSEEK_API_KEY=YOUR_KEY_HERE

# 可选：自定义服务商（AI_PROVIDER=custom 时使用）
# API_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=
