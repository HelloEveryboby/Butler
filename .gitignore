# Ignore release artifacts (Butler executable moved to release/)
/release/*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
.env
.venv
venv/
logs/

# Rust build artifacts
target/
**/target/

# SQLite databases & temp files
*.db
*.db-journal
*.sqlite
data/**/*.db
butler/data/system_data/*.db
skills/storage_hub/cache/*.db
temp_android_repo/
.env_ready
.tasks/

# AI Memory runtime directories
.butler-memory/
butler-memory/

# Executables and bin/ artifacts
**/*_exec
**/sysutil
**/memos_service
**/memory_service
**/converter
**/*.o
**/*.obj
*.exe

# Log files
*.log
sync_hub.log
server.log
sync_cache.json
.sync_cache.json

# Gradle and Android build artifacts
.gradle/
**/build/
*.aar
*.jar
**/.gradle/
local.properties

# Build and Packaging artifacts
dist/
build/
*.egg-info/
Butler.egg-info/

# Node / 前端构建（frontend/translate 等）
node_modules/
# OCR 语言包（体积大，由 npm run fetch:ocr-lang 下载，可选组件）
frontend/translate/vendor/lang/*.traineddata.gz

# OpenClaw 临时工作区（含验证脚本、测试产物、以及临时下载的浏览器二进制）
.openclaw/
