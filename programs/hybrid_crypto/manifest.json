{
    "name": "hybrid_crypto",
    "language": "rust",
    "version": "1.0",
    "description": "High-performance Rust cryptographic module for hashing and encryption. BHL compatible.",
    "protocol": "bhl",
    "build": "cargo build --release",
    "source": [
        "src/crypto_service.rs",
        "Cargo.toml"
    ],
    "executable": "target/release/hybrid_crypto_exec",
    "methods": [
        "hash_sha256",
        "hash_file",
        "encrypt_file",
        "decrypt_file"
    ]
}
